rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['username', 'email', 'money', 'unlockedModes']) &&
             data.keys().size() == 6 && // username, email, money, unlockedModes, createdAt, updatedAt
             data.username is string && data.username.size() > 0 && data.username.size() <= 50 &&
             data.email is string && data.email == request.auth.token.email &&
             data.money is number && data.money >= 0 &&
             data.unlockedModes is list && data.unlockedModes.size() <= 20 &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      
      allow update: if isOwner(userId) && isValidId(userId) && 
                    request.resource.data.email == resource.data.email &&
                    request.resource.data.createdAt == resource.data.createdAt &&
                    request.resource.data.updatedAt == request.time &&
                    request.resource.data.username is string && 
                    request.resource.data.money is number &&
                    request.resource.data.unlockedModes is list;
    }
  }
}
